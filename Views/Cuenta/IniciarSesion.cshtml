@model PROYECTO_MoneyUp.Models.IniciarSesionViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="access-page"><partial name="_AccessHeader" /><main class="access-main account-main">
<aside class="account-intro"><img src="~/images/moneyup-logo.svg" alt="Logo de MoneyUp" /><h1>¡Iniciá sesión en<br>MoneyUp!</h1><p>Organizá tus gastos, alcanzá<br>tus metas y tomá el control de<br>tu dinero.</p></aside>
<section class="account-card" aria-labelledby="login-title"><h2 id="login-title">Inicio de sesión</h2><p class="card-subtitle">Completá tus datos para ingresar.</p>
<form asp-controller="Cuenta" asp-action="IniciarSesion" method="post"><div asp-validation-summary="ModelOnly" class="form-summary" role="alert"></div><div class="form-field"><label asp-for="CorreoElectronico">Correo electrónico</label><div class="input-shell"><span class="field-icon"><img class="ui-field-icon" src="/images/icons/mail.svg" alt="" /></span><input asp-for="CorreoElectronico" type="email" autocomplete="email" placeholder="Correo electrónico" /></div><span asp-validation-for="CorreoElectronico" class="field-error"></span></div><div class="form-field"><label asp-for="Contrasena">Contraseña</label><div class="input-shell"><span class="field-icon"><img class="ui-field-icon" src="/images/icons/lock.svg" alt="" /></span><input asp-for="Contrasena" type="password" autocomplete="current-password" placeholder="Contraseña" /><button type="button" class="reveal-password" aria-label="Mostrar contraseña"><img class="ui-field-icon" src="/images/icons/eye.svg" alt="" /></button></div><span asp-validation-for="Contrasena" class="field-error"></span></div><div class="form-aux"><span class="underlined-note">Olvidé mi contraseña</span></div><button class="form-submit" type="submit">Iniciar sesión</button></form>
<div class="form-separator"><span>o</span></div><p class="form-switch">¿No tenés una cuenta? <a asp-controller="Cuenta" asp-action="Registrarse">Registrarse</a></p></section>
</main><partial name="_AccessFooter" /></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
