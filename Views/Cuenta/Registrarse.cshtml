@model PROYECTO_MoneyUp.Models.RegistroViewModel
@{ ViewData["Title"] = "Registrarse"; }
<div class="access-page"><partial name="_AccessHeader" /><main class="access-main account-main">
<aside class="account-intro"><img src="~/images/moneyup-logo.svg" alt="Logo de MoneyUp" /><h1>¡Creá tu cuenta<br>en MoneyUp!</h1><p>Organizá tus gastos, alcanzá<br>tus metas y tomá el control de<br>tu dinero.</p></aside>
<section class="account-card" aria-labelledby="signup-title"><h2 id="signup-title">Registrarse</h2><p class="card-subtitle">Completá tus datos para comenzar.</p>
<form asp-controller="Cuenta" asp-action="Registrarse" method="post"><div asp-validation-summary="ModelOnly" class="form-summary" role="alert"></div>
<div class="form-field"><label asp-for="NombreCompleto">Nombre completo</label><div class="input-shell"><span class="field-icon"><img class="ui-field-icon" src="/images/icons-moneyup/user.png" alt="" /></span><input asp-for="NombreCompleto" autocomplete="name" placeholder="Nombre completo" /></div><span asp-validation-for="NombreCompleto" class="field-error"></span></div>
<div class="form-field"><label asp-for="CorreoElectronico">Correo electrónico</label><div class="input-shell"><span class="field-icon"><img class="ui-field-icon" src="/images/icons/mail.svg" alt="" /></span><input asp-for="CorreoElectronico" type="email" autocomplete="email" placeholder="Correo electrónico" /></div><span asp-validation-for="CorreoElectronico" class="field-error"></span></div>
<div class="form-field"><label asp-for="Contrasena">Contraseña</label><div class="input-shell"><span class="field-icon"><img class="ui-field-icon" src="/images/icons/lock.svg" alt="" /></span><input asp-for="Contrasena" type="password" autocomplete="new-password" placeholder="Contraseña" /><button type="button" class="reveal-password" aria-label="Mostrar contraseña"><img class="ui-field-icon" src="/images/icons/eye.svg" alt="" /></button></div><span asp-validation-for="Contrasena" class="field-error"></span></div>
<div class="form-field"><label asp-for="ConfirmarContrasena">Confirmar contraseña</label><div class="input-shell"><span class="field-icon"><img class="ui-field-icon" src="/images/icons/lock.svg" alt="" /></span><input asp-for="ConfirmarContrasena" type="password" autocomplete="new-password" placeholder="Confirmar contraseña" /><button type="button" class="reveal-password" aria-label="Mostrar contraseña"><img class="ui-field-icon" src="/images/icons/eye.svg" alt="" /></button></div><span asp-validation-for="ConfirmarContrasena" class="field-error"></span></div>
<button class="form-submit" type="submit">Crear cuenta</button></form><p class="form-switch register-switch">¿Ya tenés una cuenta? <a asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a></p></section></main><partial name="_AccessFooter" /></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
